{
  "name": "seungwoo-noh-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build && node --import tsx scripts/prerender.tsx && npm run validate",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "validate": "node --import tsx scripts/validate-release.ts"
  },
  "dependencies": {"react": "19.2.8", "react-dom": "19.2.8"},
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "5.0.4",
    "tailwindcss": "4.1.12",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  }
}
